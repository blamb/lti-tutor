# Overrides for running Persona Chat next to the tutor on one machine.
# Copy to .env.persona (gitignored); everything not set here comes from .env.
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/persona_chat
LTI_TOOL_URL=https://your-second-tunnel.ngrok-free.dev
TOOL_NAME=Persona Chat
PERSONA_MODEL=claude-haiku-4-5
