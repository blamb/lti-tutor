# Copy to .env and fill in. .env is gitignored.

# Public URL the tool is reachable on (Moodle uses this URL).
# Dev: an ngrok static domain. Prod: your hosting domain.
LTI_TOOL_URL=https://your-tunnel.ngrok-free.dev

# Local port the Node app listens on.
PORT=3000

# Postgres for the app's own data (students, tutorials, transcripts, costs).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lti_tutor

# Random secret ltijs uses to sign cookies. Generate: openssl rand -hex 32
LTI_COOKIE_SECRET=change-me-to-a-long-random-string

# Anthropic API key. Use a key in a dedicated Console workspace so this tool's
# spend is tracked separately.
ANTHROPIC_API_KEY=sk-ant-...

# Sovereignty: an Anthropic-compatible endpoint (an institutional or in-region
# gateway that speaks the Messages API). Leave blank for api.anthropic.com.
# The same build serves either; only this URL changes.
ANTHROPIC_BASE_URL=

# Private-network hosting (Reclaim Cloud / Virtuozzo): if the LMS and this tool
# share a private network where TLS ends at a shared load balancer the
# containers cannot reach, list the LMS hostname(s) here (comma-separated,
# optional :port). Server-side calls to them go over plain HTTP on the
# internal address; the hostname, path and Host header are unchanged.
PLATFORM_HTTP_HOSTS=

# Transcripts (the turn-by-turn text of each session) older than this many
# days are deleted every night at 03:00 server time. Session summaries, the
# learner model, NPS and the instructor's report are kept. 0 = keep forever.
DATA_RETENTION_DAYS=0

# Name shown in Moodle's tool registration and the page header.
TOOL_NAME=LTI Tutor

# Model per function. Defaults are Haiku 4.5 for cost at class scale; raise to
# claude-sonnet-5-5 or claude-opus-5-5 if tutorial quality matters more than
# cost. Any model used must have a price row in src/server/costs.ts or its
# cost records as 0.
TUTOR_MODEL=claude-haiku-4-5    # the tutorial conversation
GEN_MODEL=claude-haiku-4-5      # summaries, debriefs, AI drafting

# Token gating the out-of-band /admin/costs?token=... JSON endpoint.
# Leave blank to disable. Generate: openssl rand -hex 32
ADMIN_TOKEN=
